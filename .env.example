
# --- Core ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- CORS: React dev server + production domains ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# --- Email ---
# Production (Railway) uses Resend: Railway's hobby plan blocks outbound SMTP
# ports, so SMTP never connects there. Set RESEND_API_KEY and the app sends
# over Resend's HTTPS API instead. DEFAULT_FROM_EMAIL must use a domain that
# is verified in the Resend dashboard, otherwise Resend rejects the message.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Local SMTP alternative (ignored when RESEND_API_KEY is set). Leave all of
# these unset and mail is simply printed to the terminal.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# Sender identity. The domain here must be verified in Resend.
DEFAULT_FROM_EMAIL=Madni Solar <info@madnisolar.com>

# Who gets the team notification for each kind of submission.
# Comma-separate to notify more than one address.
CONTACT_NOTIFY_EMAILS=info@madnisolar.com
CALCULATOR_NOTIFY_EMAILS=info@madnisolar.com
QUOTE_NOTIFY_EMAILS=info@madnisolar.com
ORDER_NOTIFY_EMAILS=info@madnisolar.com

# --- Checkout ---
# Flat delivery charge applied to every order, and the currency label the
# checkout shows. Exposed to the frontend via GET /api/orders/settings/.
ORDER_FLAT_SHIPPING=2000
ORDER_CURRENCY=PKR

# Used to build the admin link inside the notification email
SITE_URL=http://localhost:8000
